<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-google-auth"
        version="1.0.1">
    <name>Google Auth</name>
    <description>Sign in with Google through Android Credential Manager with a legacy compatibility fallback.</description>
    <license>MIT</license>

    <engines>
        <engine name="cordova" version=">=11.0.0" />
        <engine name="cordova-android" version=">=11.0.0" />
    </engines>

    <js-module src="www/GoogleAuth.js" name="GoogleAuth">
        <clobbers target="GoogleAuth" />
    </js-module>

    <hook type="after_prepare" src="hooks/android/after_prepare.js" />

    <platform name="android">
        <preference name="ANDROIDX_CREDENTIALS_VERSION" default="1.3.0" />
        <preference name="GOOGLE_ID_VERSION" default="1.1.1" />
        <preference name="GOOGLE_PLAY_SERVICES_AUTH_VERSION" default="19.0.0" />

        <framework src="androidx.credentials:credentials:$ANDROIDX_CREDENTIALS_VERSION" />
        <framework src="androidx.credentials:credentials-play-services-auth:$ANDROIDX_CREDENTIALS_VERSION" />
        <framework src="com.google.android.libraries.identity.googleid:googleid:$GOOGLE_ID_VERSION" />
        <framework src="com.google.android.gms:play-services-auth:$GOOGLE_PLAY_SERVICES_AUTH_VERSION" />

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="GoogleAuth">
                <param name="android-package" value="com.andreszs.cordova.googleauth.GoogleAuth" />
            </feature>
        </config-file>

        <source-file src="src/android/GoogleAuth.java"
                     target-dir="src/com/andreszs/cordova/googleauth" />
    </platform>
</plugin>
